# ==============================================================================
# UCreates Leadership Studio — Environment Configuration Template
# ==============================================================================

# Database: PostgreSQL connection string (supports local, Supabase, Neon, RDS, or Vercel Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/leadership_studio?schema=public"

# Authentication & Session Security (generate 32+ random characters)
AUTH_SECRET="your-32-character-secret-key-goes-here-randomly-generated"

# Application Base URL (for canonical URLs, Open Graph, and sitemaps)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (Local in dev, S3-compatible in production)
STORAGE_PROVIDER="local" # "local" | "s3"
# AWS_S3_BUCKET=""
# AWS_S3_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Node environment (managed automatically by Next.js — do NOT define in .env)
# NODE_ENV="development"
